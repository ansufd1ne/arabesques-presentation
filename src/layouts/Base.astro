---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { site, social, ids } from '../data/site';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import antonUrl from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';

const gaId = (import.meta.env.PUBLIC_GA_ID ?? '').trim();
interface Props { title: string; description: string; image?: string; crumb?: string; }
const { title, description, image = '/og-default.jpg', crumb } = Astro.props;
const path = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(path === '/' ? '/' : path, site.url).href;
const ogImage = new URL(image, site.url).href;

const names: Record<string, string> = {
  festival: 'Le festival', programmation: 'Programmation', presse: 'Presse', 'communique-2026': 'Communiqué de presse 2026',
  'arabesques-music-forum': 'Arabesques Music Forum', 'caravane-arabesques': 'Caravane Arabesques',
  'informations-pratiques': 'Informations pratiques', partenaires: 'Partenaires', contact: 'Contact',
  'mentions-legales': 'Mentions légales', 'conditions-generales-de-vente': 'Conditions générales de vente',
  'politique-de-confidentialite': 'Politique de confidentialité',
};
const segs = path.split('/').filter(Boolean);
const crumbs = segs.map((seg, i) => ({
  '@type': 'ListItem', position: i + 2,
  name: i === segs.length - 1 && crumb ? crumb : names[seg] ?? seg,
  item: new URL('/' + segs.slice(0, i + 1).join('/'), site.url).href,
}));
const graph: object[] = [
  { '@type': 'Organization', '@id': ids.org, name: site.org, url: 'https://www.unisons.fr/',
    logo: `${site.url}/og-default.jpg`, telephone: '+33 4 99 77 00 17',
    address: { '@type': 'PostalAddress', streetAddress: '475 Avenue du Comté de Nice', postalCode: '34080', addressLocality: 'Montpellier', addressCountry: 'FR' },
    sameAs: social.map((s) => s.href) },
  { '@type': 'WebSite', '@id': `${site.url}/#site`, url: `${site.url}/`, name: site.name, inLanguage: 'fr-FR', publisher: { '@id': ids.org } },
];
if (segs.length) graph.push({ '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Accueil', item: site.url + '/' }, ...crumbs] });
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={antonUrl} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('reveal-ready', 'intro-ready');
    </script>
    <noscript><style>#menu-open { display: none; }</style></noscript>
    {gaId && <meta name="ga-id" content={gaId} />}
    <slot name="head" />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a class="skip" href="#main">Aller au contenu</a>
    <Navbar />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <ConsentBanner analytics={!!gaId} />
    <script is:inline>
      // Éléments déjà à l'écran à l'ouverture : affichés tout de suite, sans attendre le script de page (LCP)
      (function () {
        if (!document.documentElement.classList.contains('reveal-ready')) return;
        var limit = innerHeight * 0.95;
        document.querySelectorAll('[data-reveal]').forEach(function (el) { if (el.getBoundingClientRect().top <= limit) el.removeAttribute('data-reveal'); });
      })();
    </script>
    <script>
      import '../scripts/letter-roll.ts';
      import '../scripts/reveal.ts';
      import '../scripts/intro.ts';
      import '../scripts/scroll-fx.ts';
      import '../scripts/view-cursor.ts';
      import '../scripts/hscroll.ts';
      import '../scripts/analytics.ts';
    </script>
  </body>
</html>
