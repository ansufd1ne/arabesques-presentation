---
import { Image } from 'astro:assets';
import logo from '../assets/logo/arabesques-wordmark-yellow.png';
const endpoint = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT ?? '';
import { site } from '../data/site';
const email = site.contactEmail;
---
<section class="news" aria-labelledby="news-title">
  <div class="box" data-reveal="bottom">
    <a class="logo" href="/" aria-label="Festival Arabesques, accueil">
      <Image src={logo} alt="Arabesques Festival" width={504} height={122} loading="lazy" format="webp" />
    </a>
    <h2 id="news-title" class="title">La newsletter de l’Art Est Public</h2>
    <p class="sub">Ne manquez aucun événement : inscrivez-vous à notre newsletter !</p>

    <form class="form" id="newsletter-form" method="post" action={endpoint || undefined} data-endpoint={endpoint} data-email={email} novalidate>
      <label class="visually-hidden" for="news-email">Adresse e-mail</label>
      <input id="news-email" name="email" type="email" required autocomplete="email" placeholder="Saisir votre e-mail" />
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
      <button class="send" type="submit"><span>S’inscrire</span></button>
    </form>
    <label class="consent">
      <input type="checkbox" name="consentement" value="1" form="newsletter-form" required data-erreur="Consentement à la politique de confidentialité" />
      <span>J’accepte de recevoir les e-mails d’UNi’SONS et confirme avoir pris connaissance de la <a href="/politique-de-confidentialite">politique de confidentialité</a>. Désinscription possible à tout moment.</span>
    </label>
    <p class="status" role="status" aria-live="polite"></p>
    <p class="error" role="alert"></p>
  </div>
</section>

<style>
  /* Base fluide (< 1330 px) */
  .news { background: var(--pink); padding: 64px var(--pad); }
  .box { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; text-align: center; gap: 16px; }
  .logo { display: flex; align-items: center; justify-content: center; width: 286px; max-width: 100%; height: 61px; }
  .logo :global(img) { display: block; height: 61px; width: auto; max-width: 100%; }
  .title { font: 400 clamp(30px, 5vw, 40px) / 1.1 var(--font-display); text-transform: uppercase; color: var(--yellow); letter-spacing: 0; }
  .sub { font: italic 300 clamp(24px, 2.4vw, 25px) / 1.2 var(--font-body); letter-spacing: -0.03em; text-transform: uppercase; color: var(--yellow); max-width: 860px; }
  .form { display: flex; align-items: center; justify-content: space-between; gap: 8px; width: 100%; max-width: 672px; height: 68px; padding: 8px 8px 8px 20px; margin-top: 8px; background: #f5f5f5; border-radius: 24px; }
  .form input[name='email'] { flex: 1; min-width: 0; padding: 0; background: transparent; border: 0; border-radius: 0; font: 400 16px / 24px var(--font-body); color: #4c4c4c; }
  .form input[name='email']::placeholder { color: #4c4c4c; opacity: 1; }
  .form input[name='email']:focus-visible { outline: none; }
  .news :focus-visible { outline-color: var(--yellow); } /* jaune sur rose : 3,16:1 (le rose foncé du focus global y est invisible) */
  .form:has(input[aria-invalid='true']) { box-shadow: 0 0 0 3px #8c1d18; }
  .consent input[aria-invalid='true'] { outline: 3px solid #fff; outline-offset: 2px; }
  .form:focus-within { outline: 3px solid var(--yellow); outline-offset: 3px; }
  .hp { position: absolute; left: -9999px; }
  .send { flex: none; display: flex; align-items: center; justify-content: center; height: 40px; min-width: 98px; padding: 8px 16px; background: #1d1d1d; border: 0; border-radius: 32px; cursor: pointer; }
  .send span { padding: 0 4px; font: 400 14px / 20px var(--font-body); color: var(--yellow); text-align: center; white-space: nowrap; }
  .send:hover, .send:focus-visible { background: var(--yellow); }
  .send:hover span, .send:focus-visible span { color: #1d1d1d; }
  .consent { display: flex; align-items: flex-start; gap: 12px; max-width: 672px; text-align: left; font: 400 13px / 20px var(--font-body); color: #fff; }
  .consent input { flex: none; width: 20px; height: 20px; margin: 0; accent-color: var(--yellow); }
  .consent a { text-decoration: underline; text-underline-offset: 3px; }
  .consent:focus-within { outline: 3px solid var(--yellow); outline-offset: 3px; }
  .send:disabled { opacity: .55; cursor: not-allowed; }
  .send:disabled:hover { background: #1d1d1d; }
  .send:disabled:hover span { color: var(--yellow); }
  .status { min-height: 24px; font: 500 14px / 24px var(--font-body); color: #fff; }
  .status[data-state='ok'] { font-weight: 700; }
  .error { max-width: 672px; padding: 10px 14px; border-left: 8px solid #8c1d18; background: #fff; color: #8c1d18; font: 600 14px / 22px var(--font-body); text-align: left; }
  .error:empty { display: none; }
  .error::before { content: 'Erreur. '; font-weight: 800; }

  /* Reproduction à la cote de la maquette Figma (cadre 1440 × 396, conteneur 1310 × 265) */
  @media (min-width: 1330px) {
    .news { height: 450px; padding: 80px 0 0; }
    .box { position: relative; display: block; width: 1310px; height: 320px; margin-left: calc(50% - 660px); text-align: left; }
    .logo { position: absolute; left: 512px; top: 0; width: 286px; height: 61px; }
    .title { position: absolute; left: 655px; top: 81px; transform: translateX(-50%); margin: 0; font-size: 40px; line-height: 20px; text-align: center; white-space: nowrap; }
    .sub { position: absolute; left: 238px; top: 118px; margin: 0; max-width: none; font-size: 25px; line-height: 1.2; letter-spacing: -0.75px; white-space: nowrap; }
    .form { position: absolute; left: 319px; top: 165px; width: 672px; max-width: none; margin: 0; }
    .consent { position: absolute; left: 319px; top: 245px; width: 672px; max-width: none; margin: 0; }
    .status, .error { position: absolute; left: 319px; top: 300px; width: 672px; min-height: 0; margin: 0; text-align: center; }
    .error { text-align: left; }
  }
  @media (max-width: 600px) {
    .news { padding-block: 48px; }
    .form { height: 60px; padding-left: 16px; }
  }
</style>

<script>
  import { initForm } from '../scripts/form-submit';
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const status = document.querySelector('.news .status') as HTMLElement | null;
  const error = document.querySelector('.news .error') as HTMLElement | null;
  if (form && status && error) {
    const email = form.dataset.email ?? '';
    initForm({
      form, status, error,
      piege: 'website',
      messages: {
        envoi: 'Inscription en cours',
        succes: 'Merci, votre inscription est bien prise en compte.',
        echec: 'L’inscription a échoué. Votre saisie est conservée : vous pouvez réessayer dans un instant, ou nous écrire via la page contact.',
        delai: 'Le serveur met trop de temps à répondre (plus de 15 secondes). Votre saisie est conservée : vous pouvez réessayer.',
        patience: 'Merci de patienter quelques secondes avant une nouvelle tentative.',
      },
      messageMailto: `Votre messagerie s’ouvre avec la demande d’inscription prête à envoyer. Si rien ne s’ouvre, écrivez-nous à ${email}.`,
      mailto: (d) => email ? `mailto:${email}?subject=${encodeURIComponent('Inscription à la newsletter')}&body=${encodeURIComponent(`Bonjour, merci de m’inscrire à la newsletter du festival Arabesques avec l’adresse ${d.get('email')}.`)}` : null,
    });
  }
</script>
