---
import { Image } from 'astro:assets';
import logo from '../assets/logo/arabesques.png';
import unisons from '../assets/logo/unisons.png';
import { footerCols, site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="top" data-reveal="bottom">
    <div class="id">
      <Image class="logo" src={logo} alt="Arabesques Festival" width={120} height={29} densities={[1, 1.5]} format="webp" />
      <address>
        <Image class="uni" src={unisons} alt="UNi’SONS" width={80} height={34} format="webp" />
        <p>{site.org}<br />{site.address[0]}<br />{site.address[1]}</p>
        <p><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a><br />{site.hours}</p>
      </address>
    </div>
    {footerCols.map((c) => (
      <nav aria-label={c.title}>
        <h2 class="label">{c.title}</h2>
        <ul>{c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
    ))}
  </div>
  <p class="copy">© {year} UNi’SONS, Festival Arabesques. Crédit photos : Luc Jennepin. <button type="button" class="cc" data-consent-open>Gérer les cookies</button></p>
  <p class="word display" aria-hidden="true">Arabesques</p>
</footer>

<style>
  .footer { background: var(--bg); padding: 80px var(--pad) 0; overflow: hidden; }
  .top { display: grid; grid-template-columns: 1.1fr 1fr 1fr 1fr; gap: 40px; }
  .logo { height: 29px; width: auto; }
  address { font-style: normal; margin-top: 40px; font-size: 14px; line-height: 20px; }
  .uni { height: 46px; width: auto; margin-bottom: 16px;  }
  address p + p { margin-top: 16px; color: var(--white); font-weight: 500; }
  nav ul { margin-top: 28px; display: grid; gap: 22px; }
  nav a { font: 500 14px/1.3 var(--font-body); letter-spacing: .15em; text-transform: uppercase; color: var(--muted); }
  nav a:hover { color: var(--pink-soft); }
  .copy { position: relative; z-index: 2; margin-top: 56px; font-size: 14px; }
  .cc { margin-left: 12px; font: inherit; color: var(--muted); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .cc:hover, .cc:focus-visible { color: var(--pink-soft); }
  .word { color: var(--pink); font-size: 21.5vw; line-height: .86; letter-spacing: -0.02em; text-align: center; margin: 56px 0 -2.2vw; white-space: nowrap; }
  @media (max-width: 900px) {
    .top { grid-template-columns: 1fr 1fr; gap: 36px 20px; }
    .id { grid-column: 1 / -1; }
    .word { font-size: 21vw; }
  }
</style>
