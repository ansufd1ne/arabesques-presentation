---
import { Picture } from 'astro:assets';
import img from '../assets/photos/public.jpg';
---
<section class="about section" aria-labelledby="about-title" data-scrub data-y="20,0" data-opacity=".85,1" data-window="0,.2" data-smooth=".1">
  <p class="label" data-reveal="left">L’esprit du festival</p>
  <div class="col" data-reveal="bottom" data-reveal-delay="120">
    <h2 id="about-title" class="display" data-highlight>UNi’SONS a créé le festival Arabesques en 2006. Il a lieu chaque année en septembre au cœur de Montpellier et réunit des artistes de toutes disciplines autour de la diversité culturelle et du vivre ensemble.</h2>
    <Picture class="photo" src={img} formats={['avif', 'webp']} fallbackFormat="webp" widths={[393, 786]} sizes="393px" alt="Le public du festival Arabesques, édition 2026" loading="lazy" />
    <a class="bracket more" href="/festival">En savoir plus</a>
  </div>
</section>

<style>
  .about { display: grid; grid-template-columns: 448px 1fr; padding-top: 80px; padding-bottom: 90px; min-height: 825px; }
  h2 { font-size: 36px; line-height: 1.33; letter-spacing: -0.02em; max-width: 872px; }
  .col :global(.photo) { width: 393px; height: 237px; object-fit: cover; margin-top: 72px; filter: grayscale(1); }
  .more { display: inline-block; margin-top: 88px; }
  @media (max-width: 1100px) {
    .about { grid-template-columns: 1fr; gap: 24px; min-height: 0; padding-block: 64px; }
    .col :global(.photo) { width: min(100%, 640px); height: auto; aspect-ratio: 16/10; margin-top: 40px; }
    .more { margin-top: 40px; }
  }
  @media (max-width: 900px) {
    .about { grid-template-columns: 1fr; gap: 24px; min-height: 0; padding-block: 56px; }
    h2 { font-size: 28px; }
    .col :global(.photo) { width: 100%; height: auto; aspect-ratio: 16/10; margin-top: 32px; }
    .more { margin-top: 32px; }
  }
</style>
