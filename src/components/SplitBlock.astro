---
import { Picture } from 'astro:assets';
interface Props { title: string; paragraphs: string[]; image: ImageMetadata; alt: string; flip?: boolean; href?: string; cta?: string; label?: string; }
const { title, paragraphs, image, alt, flip = false, href, cta, label } = Astro.props;
---
<section class={`split ${flip ? 'flip' : ''}`}>
  <div class="media" data-reveal={flip ? 'right' : 'left'}><Picture src={image} formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 640, 1280]} sizes="(max-width: 900px) 100vw, 580px" alt={alt} loading="lazy" /></div>
  <div class="txt" data-reveal={flip ? 'left' : 'right'}>
    {label && <p class="label">{label}</p>}
    <h2 class="display">{title}</h2>
    {paragraphs.map((p) => <p>{p}</p>)}
    {href && <a class="bracket" href={href}>{cta}</a>}
  </div>
</section>

<style>
  .split { display: grid; grid-template-columns: 580px 1fr; gap: 80px; align-items: start; padding: 64px var(--pad); border-top: 1px solid var(--line); }
  .flip { grid-template-columns: 1fr 580px; }
  .flip .media { order: 2; }
  .media :global(img) { width: 100%; aspect-ratio: 580 / 400; object-fit: cover; }
  .txt { display: grid; gap: 18px; align-content: start; }
  h2 { font-size: var(--text-3xl); line-height: 1.15; }
  .bracket { margin-top: 12px; justify-self: start; }
  @media (max-width: 1100px) {
    .split, .flip { grid-template-columns: 1fr; gap: 28px; padding-block: 48px; }
    .flip .media { order: 0; }
  }
  @media (max-width: 900px) {
    .split, .flip { grid-template-columns: 1fr; gap: 28px; padding-block: 40px; }
    .flip .media { order: 0; }
  }
</style>
